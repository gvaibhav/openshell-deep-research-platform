{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openshell-deep-research.invalid/v1/job-event.schema.json",
  "title": "Research job event",
  "description": "Small viewer-specific status event. The API maps untrusted worker output to trusted static templates and suppresses evidence events unless the viewer has current read_evidence and exact-source authorization; raw source content, worker prose, and credentials are excluded. Recheck job and source access for replay and live delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "job_id", "sequence", "at", "type", "message"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "job_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 0},
    "at": {"type": "string", "format": "date-time"},
    "type": {"type": "string", "enum": ["status", "progress", "evidence", "warning", "error"]},
    "status": {
      "type": "string",
      "enum": ["submitted", "authorized", "queued", "provisioning", "running", "awaiting_review", "completing", "completed", "failed", "canceled", "expired"]
    },
    "message": {
      "type": "string",
      "description": "Trusted API template, never raw worker or connector text.",
      "enum": [
        "Job submitted.",
        "Job authorized.",
        "Job queued.",
        "Research environment starting.",
        "Research in progress.",
        "Review required.",
        "Report being prepared.",
        "Job completed.",
        "Job failed.",
        "Job canceled.",
        "Job expired.",
        "Evidence captured.",
        "Source access requires review."
      ]
    },
    "evidence_id": {
      "type": "string", "format": "uuid",
      "description": "Only emit if this viewer can currently GET the scoped evidence endpoint; otherwise suppress the entire evidence event."
    },
    "progress_percent": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}

