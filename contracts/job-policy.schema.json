{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openshell-deep-research.invalid/v1/job-policy.schema.json",
  "title": "Authoritative research job policy",
  "description": "Created and retained by the controller after authentication and entitlement checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id", "policy_version", "tenant_id", "user_subject", "created_at", "expires_at", "mode",
    "approved_sources", "model_route", "classification", "limits", "allowed_tools"
  ],
  "properties": {
    "job_id": {"type": "string", "format": "uuid"},
    "policy_version": {"type": "integer", "minimum": 1},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "user_subject": {"type": "string", "minLength": 1, "maxLength": 500},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "mode": {"type": "string", "enum": ["public", "enterprise", "combined"]},
    "public_research_brief": {
      "type": "string", "minLength": 20, "maxLength": 2000,
      "description": "Server-approved brief for the public stage of a combined job."
    },
    "public_brief_approval_ref": {
      "type": "string", "minLength": 1, "maxLength": 300,
      "description": "Opaque reference to the server-side approval or DLP decision."
    },
    "approved_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "source-selection.schema.json"}
    },
    "model_route": {"type": "string", "minLength": 1, "maxLength": 200},
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds", "max_model_tokens", "max_tool_calls", "max_source_bytes", "max_output_bytes", "max_sources", "max_subagents", "max_estimated_cost_usd"],
      "properties": {
        "wall_time_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "max_model_tokens": {"type": "integer", "minimum": 1000, "maximum": 10000000},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_source_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
        "max_sources": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_subagents": {"type": "integer", "minimum": 0, "maximum": 100},
        "max_estimated_cost_usd": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"}
    }
  },
  "if": {"properties": {"mode": {"const": "combined"}}},
  "then": {"required": ["public_research_brief", "public_brief_approval_ref"]}
}

