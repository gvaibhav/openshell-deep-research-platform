{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openshell-deep-research.invalid/v1/reader-grant.schema.json",
  "title": "Server-held individual job reader grant",
  "description": "P1 named, action-scoped and expiring read grant. The canonical subject and audit fields are server-verified; current tenant and source eligibility are still required at read time. Revoked grants are removed from the active ACL and retained in append-only audit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["grant_id", "subject", "actions", "expires_at", "granted_at", "granted_by_subject"],
  "properties": {
    "grant_id": {"type": "string", "format": "uuid"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 500},
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["list_job", "read_status", "read_events", "read_report", "read_evidence"]}
    },
    "expires_at": {"type": "string", "format": "date-time"},
    "granted_at": {"type": "string", "format": "date-time"},
    "granted_by_subject": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
