{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openshell-deep-research.invalid/v1/stage-manifest.schema.json",
  "title": "Research stage manifest",
  "description": "A narrow, controller-issued projection of a job policy for exactly one sandbox stage. It contains no raw source credentials or user identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id", "job_id", "attempt_id", "sandbox_id", "fencing_generation",
    "policy_version", "stage", "research_brief",
    "issued_at", "expires_at", "approved_sources", "allowed_tools",
    "model_route", "classification", "limits"
  ],
  "properties": {
    "manifest_id": {"type": "string", "format": "uuid"},
    "job_id": {"type": "string", "format": "uuid"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "sandbox_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "fencing_generation": {"type": "integer", "minimum": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "stage": {"type": "string", "enum": ["public", "enterprise"]},
    "research_brief": {"type": "string", "minLength": 10, "maxLength": 12000},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "approved_sources": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"$ref": "source-selection.schema.json"}
    },
    "allowed_tools": {"$ref": "job-policy.schema.json#/properties/allowed_tools"},
    "model_route": {"type": "string", "minLength": 1, "maxLength": 200},
    "classification": {
      "type": "string", "enum": ["public", "internal", "confidential", "restricted"]
    },
    "limits": {"$ref": "job-policy.schema.json#/properties/limits"},
    "context_evidence_ids": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"},
      "description": "Reviewed public evidence projected into a private stage; never a reference to unreviewed private data."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "public"}}},
      "then": {
        "properties": {
          "classification": {"const": "public"},
          "approved_sources": {
            "items": {"properties": {"connector": {"const": "public_web"}}}
          },
          "allowed_tools": {
            "items": {"enum": ["search_public_web", "fetch_public_page"]}
          },
          "context_evidence_ids": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "approved_sources": {
            "items": {"properties": {"connector": {"not": {"const": "public_web"}}}}
          },
          "allowed_tools": {
            "items": {"not": {"enum": ["search_public_web", "fetch_public_page"]}}
          }
        }
      }
    }
  ]
}
