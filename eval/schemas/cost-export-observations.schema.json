{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openshell-deep-research.invalid/eval/v1/cost-export-observations.schema.json",
  "title": "Isolated synthetic cost and export observations",
  "description": "Unused local fragment contract, not candidate-run v3 or signed control review. Cross-cell bindings, artifact bytes, finite numeric values and timestamp order require the helper; reviewer authenticity, product-event truth, approved plan and semantic correspondence remain external gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "observer_id",
    "required_cases",
    "observations",
    "corroborations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_id": {
      "$ref": "#/$defs/id"
    },
    "observer_id": {
      "$ref": "#/$defs/id"
    },
    "required_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "corroborations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/corroboration"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "time": {
      "type": "string",
      "maxLength": 40,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "cost": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "amount_usd",
            "evidence"
          ],
          "properties": {
            "status": {
              "const": "observed"
            },
            "amount_usd": {
              "type": "number",
              "minimum": 0
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "evidence"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "#/$defs/text"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      ]
    },
    "exported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "attempted_at",
        "completed_at",
        "format",
        "artifact",
        "product_event"
      ],
      "properties": {
        "status": {
          "const": "exported"
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "attempted_at": {
          "$ref": "#/$defs/time"
        },
        "completed_at": {
          "$ref": "#/$defs/time"
        },
        "format": {
          "$ref": "#/$defs/text"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "product_event": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "export_failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence",
        "method",
        "attempted_at"
      ],
      "properties": {
        "status": {
          "const": "failed"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "method": {
          "$ref": "#/$defs/text"
        },
        "attempted_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "export_unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence",
        "capability_checked_at"
      ],
      "properties": {
        "status": {
          "const": "unsupported"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "capability_checked_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "export_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "export_not_attempted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "status": {
          "const": "not_attempted"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "export_not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence",
        "expected_denial_case_id"
      ],
      "properties": {
        "status": {
          "const": "not_applicable"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "expected_denial_case_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "report_export": {
      "oneOf": [
        {
          "$ref": "#/$defs/exported"
        },
        {
          "$ref": "#/$defs/export_failed"
        },
        {
          "$ref": "#/$defs/export_unsupported"
        },
        {
          "$ref": "#/$defs/export_unavailable"
        },
        {
          "$ref": "#/$defs/export_not_attempted"
        },
        {
          "$ref": "#/$defs/export_not_applicable"
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "expected_behavior"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "expected_behavior": {
          "enum": [
            "answer",
            "abstain",
            "deny"
          ]
        }
      }
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "status",
        "run_id",
        "observed_behavior",
        "protected_content_disclosed",
        "answer_artifact_ref",
        "raw_answer_sha256",
        "citations_sha256",
        "cost",
        "report_export"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "const": "completed"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "observed_behavior": {
          "enum": [
            "answer",
            "abstained",
            "denied"
          ]
        },
        "protected_content_disclosed": {
          "type": "boolean"
        },
        "answer_artifact_ref": {
          "$ref": "#/$defs/text"
        },
        "raw_answer_sha256": {
          "$ref": "#/$defs/digest"
        },
        "citations_sha256": {
          "$ref": "#/$defs/digest"
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "report_export": {
          "$ref": "#/$defs/report_export"
        }
      }
    },
    "noncompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "status",
        "reason"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "deferred",
            "failed"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/completed"
        },
        {
          "$ref": "#/$defs/noncompleted"
        }
      ]
    },
    "cost_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "observation_sha256",
        "evidence",
        "window_start",
        "window_end",
        "allocation_basis"
      ],
      "properties": {
        "decision": {
          "enum": [
            "corroborated",
            "blocked"
          ]
        },
        "observation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "window_start": {
          "$ref": "#/$defs/time"
        },
        "window_end": {
          "$ref": "#/$defs/time"
        },
        "allocation_basis": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "artifact_sha256",
        "product_event_sha256",
        "raw_answer_sha256",
        "citations_sha256",
        "inspection_method",
        "evidence"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "product_event_sha256": {
          "$ref": "#/$defs/digest"
        },
        "raw_answer_sha256": {
          "$ref": "#/$defs/digest"
        },
        "citations_sha256": {
          "$ref": "#/$defs/digest"
        },
        "inspection_method": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "export_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "observation_sha256",
        "evidence"
      ],
      "properties": {
        "decision": {
          "enum": [
            "corroborated",
            "blocked"
          ]
        },
        "observation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "correspondence": {
          "$ref": "#/$defs/correspondence"
        }
      }
    },
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "case_id",
        "run_id",
        "reviewer_id",
        "cost",
        "report_export"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "cost": {
          "$ref": "#/$defs/cost_check"
        },
        "report_export": {
          "$ref": "#/$defs/export_check"
        }
      }
    }
  }
}
