{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openshell-deep-research.invalid/eval/v3/witness-receipt.schema.json",
  "title": "Pre-reveal matched review witness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cell_count", "packet_count", "disposition_count",
    "packet_manifest_sha256", "candidate_map_sha256",
    "reviews_sha256", "raw_observations_sha256", "control_review_sha256", "control_signature_sha256",
    "witness_id", "witness_public_key_sha256", "control_reviewer_id",
    "control_public_key_sha256", "witnessed_at"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "cell_count": {"type": "integer", "minimum": 1, "maximum": 240},
    "packet_count": {"type": "integer", "minimum": 0, "maximum": 128},
    "disposition_count": {"type": "integer", "minimum": 0, "maximum": 240},
    "packet_manifest_sha256": {"$ref": "#/$defs/digest"},
    "candidate_map_sha256": {"$ref": "#/$defs/digest"},
    "reviews_sha256": {"$ref": "#/$defs/digest"},
    "raw_observations_sha256": {"$ref": "#/$defs/digest"},
    "control_review_sha256": {"$ref": "#/$defs/digest"},
    "control_signature_sha256": {"$ref": "#/$defs/digest"},
    "witness_id": {"type": "string", "minLength": 1},
    "witness_public_key_sha256": {"$ref": "#/$defs/digest"},
    "control_reviewer_id": {"type": "string", "minLength": 1},
    "control_public_key_sha256": {"$ref": "#/$defs/digest"},
    "witnessed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
