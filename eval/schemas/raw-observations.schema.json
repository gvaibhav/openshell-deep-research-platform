{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openshell-deep-research.invalid/eval/v2/raw-observations.schema.json",
  "title": "Custodian raw observations and complete cell dispositions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cell_count", "corpus_digest", "source_pack_digest", "rubric_digest", "observations"],
  "properties": {
    "schema_version": {"const": 2},
    "cell_count": {"type": "integer", "minimum": 1, "maximum": 240},
    "corpus_digest": {"$ref": "#/$defs/digest"},
    "source_pack_digest": {"$ref": "#/$defs/digest"},
    "rubric_digest": {"$ref": "#/$defs/digest"},
    "observations": {"type": "array", "minItems": 1, "maxItems": 240, "items": {"oneOf": [{"$ref": "#/$defs/completed"}, {"$ref": "#/$defs/disposition"}]}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "metric": {"type": "number", "minimum": 0},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {"ref": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "screening": {
      "type": "object", "additionalProperties": false,
      "required": ["custodian_id", "screened_at", "record_ref", "raw_answer_sha256", "packet_answer_sha256"],
      "properties": {
        "custodian_id": {"$ref": "#/$defs/id"},
        "screened_at": {"type": "string", "format": "date-time"},
        "record_ref": {"$ref": "#/$defs/text"},
        "raw_answer_sha256": {"$ref": "#/$defs/digest"},
        "packet_answer_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "quote", "start", "end"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 4096},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "completed": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "case_id", "candidate_id", "run_id", "candidate_version", "model_version", "source_delivery", "answer_artifact_ref", "latency_ms", "cost_usd", "user_effort_minutes", "raw_answer", "packet_answer", "screening", "citations"],
      "properties": {
        "status": {"const": "completed"},
        "case_id": {"$ref": "#/$defs/id"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "candidate_version": {"$ref": "#/$defs/text"},
        "model_version": {"$ref": "#/$defs/text"},
        "source_delivery": {"$ref": "#/$defs/text"},
        "answer_artifact_ref": {"$ref": "#/$defs/text"},
        "latency_ms": {"$ref": "#/$defs/metric"},
        "cost_usd": {"$ref": "#/$defs/metric"},
        "user_effort_minutes": {"$ref": "#/$defs/metric"},
        "raw_answer": {"type": "string", "minLength": 1, "maxLength": 20000},
        "packet_answer": {"type": "string", "minLength": 1, "maxLength": 20000},
        "screening": {"$ref": "#/$defs/screening"},
        "citations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "candidate_id", "status", "reason", "disposition_evidence"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["deferred", "failed"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"},
        "disposition_evidence": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
