# OpenShell Deep Research input worksheet. Copy to .env; .env is ignored by Git.
# This repository has no application configuration loader yet. The post-selection
# application build will validate these names and fail closed on incomplete profiles.
# Put only nonsecret values or secret-manager/file REFERENCES here. Never paste a
# client secret, API key, source grant, refresh token, worker bearer, or service-
# account JSON into this file. A local file reference should point into .secrets/.

# No user values are needed to start coding the synthetic feasibility harness.
# Allowed planned profiles: fixture, sandbox_spike, live_public, enterprise.
RESEARCH_PROFILE=fixture
# Allowed planned targets: local, openshift, gke. Advisory only: planned image
# and deployment guards must independently prevent fixture/spike deployment.
RESEARCH_DEPLOYMENT_TARGET=local
RESEARCH_DASHBOARD_ORIGIN=http://localhost:3000
RESEARCH_API_ORIGIN=http://localhost:8000

# Milestone 1: live OpenShell sandbox spike. Leave blank for harness preparation.
OPENSHELL_GATEWAY_URL=
OPENSHELL_WORKSPACE_NAME=
# Name of an isolated host-side local OpenShell CLI profile for the disposable
# spike. Its credential remains in CLI storage; never put a gateway token here.
OPENSHELL_SPIKE_GATEWAY_PROFILE_NAME=

# Milestone 1 ChatGPT Enterprise synthetic comparison only. The ChatGPT tenant
# does not connect to the local OpenShell gateway. A separate case-filtered MCP
# fixture may be reached through an approved Secure MCP Tunnel; these are
# nonsecret references and do not enable a connection by themselves.
# Record Mac-local MCP compatibility separately from hosted Deep Research.
# A local trial also needs observed Work Local entitlement and effective
# enterprise/device MCP policy permission for this server; Mac app settings
# do not grant those rights or workspace custom-app/Platform tunnel roles.
CHATGPT_BASELINE_MAC_APP_VERSION=
CHATGPT_BASELINE_MAC_EXECUTION_MODE=
CHATGPT_BASELINE_TUNNEL_ID=
CHATGPT_BASELINE_WORKSPACE_REF=
CHATGPT_BASELINE_PLATFORM_ORG_REF=
CHATGPT_BASELINE_TUNNEL_RUNTIME_KEY_REF=
# Authorized human and draft app references are needed to record actual source
# selection and a fresh ChatGPT conversation for each synthetic case.
CHATGPT_BASELINE_TESTER_REF=
CHATGPT_BASELINE_DRAFT_APP_REF=
# Pin the exact reviewed client artifact selected after CVE triage. The offline
# inspected v0.0.18 macOS ARM64 client has an unresolved high finding, so it is
# not an automatically approved live version.
CHATGPT_BASELINE_TUNNEL_CLIENT_VERSION=
CHATGPT_BASELINE_TUNNEL_CLIENT_SHA256=

# Milestone 1/3: approved model for a local synthetic sandbox spike or live
# public research. These values are approval inputs, not route authority: the
# trusted model gate requires an exact reviewed route-catalog match for endpoint,
# model, auth reference, data class, and trace/retention policy.
MODEL_PROVIDER=openai
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-5.6-sol
# Disposable local synthetic spike only: set RESEARCH_OPENAI_API_KEY for the
# host relay process only. Do not put its value in this file, CI, an image, or
# the worker sandbox. The launcher must strip it from OpenShell CLI children.
# The relay must explicitly select the reviewed
# OpenAI adapter; these worksheet values do not enable it by themselves.
# The post-selection application still uses the approved secret reference or
# workload identity mode below through its server-side model gate.
# Planned values: secret_ref or workload_identity. A real model requires exactly
# the matching reference below; an empty ref never selects a fallback identity.
MODEL_AUTH_MODE=
MODEL_CREDENTIAL_REF=
MODEL_WORKLOAD_IDENTITY_REF=
# Milestone 3 public search. These are approval inputs; the trusted fetch/search
# service must match a reviewed public route and keep its credential out of workers.
PUBLIC_SEARCH_PROVIDER=
PUBLIC_SEARCH_CREDENTIAL_REF=

# Milestone 3: nonproduction Okta dashboard BFF and gateway service clients.
# Keep the issuer/audience/client separation specified in the Okta handoff.
OKTA_DASHBOARD_ISSUER=
OKTA_DASHBOARD_CLIENT_ID=
OKTA_DASHBOARD_CLIENT_AUTH=client_secret_basic
OKTA_DASHBOARD_CLIENT_SECRET_REF=
OKTA_DASHBOARD_REDIRECT_URI=
OKTA_DASHBOARD_LOGOUT_REDIRECT_URI=
OKTA_DASHBOARD_SCOPES="openid profile email groups"
OKTA_GATEWAY_ISSUER=
OKTA_GATEWAY_AUDIENCE=api://openshell-gateway
OKTA_CONTROLLER_CLIENT_ID=
OKTA_CONTROLLER_CLIENT_SECRET_REF=
OKTA_PROVISIONER_CLIENT_ID=
OKTA_PROVISIONER_CLIENT_SECRET_REF=

# Current group membership and tenant-to-group mappings need an Okta/team-
# approved mechanism and reviewed catalog; group IDs are not free-form env ACLs.
OKTA_MEMBERSHIP_SOURCE=
OKTA_MEMBERSHIP_CLIENT_ID=
OKTA_MEMBERSHIP_PRIVATE_KEY_REF=
TENANT_CATALOG_PATH=

# Milestone 4: one approved enterprise source. The manifest will record the
# source owner, issuer, canonical MCP resource, client, scopes, and grant mode.
# Its credential is a separate secret reference in that reviewed manifest.
FIRST_CONNECTOR_MANIFEST_PATH=

# Milestone 5: this is only a pointer to a reviewed, pinned per-environment
# deployment manifest. Cluster context, namespace, project, region, and image
# admission policy live in that manifest, not in application env configuration.
DEPLOYMENT_MANIFEST_PATH=
